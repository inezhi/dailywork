{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@daily/contracts": ["packages/contracts/src/index.ts"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "packages/contracts/src/**/*.ts"]
}
