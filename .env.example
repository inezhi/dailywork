# 首次启动后是否允许继续公开注册；默认 0，仅允许创建第一个账户。
DAILYWORK_OPEN_REGISTRATION=0

# 由反向代理终止 TLS 时设为 1，让会话 cookie 带 Secure。
DAILYWORK_SECURE_COOKIES=0

# 信任反向代理传入的 X-Forwarded-Proto；仅在代理可控时开启。
DAILYWORK_TRUST_PROXY=0

# 仅在构建镜像时使用；不要把代理写进容器运行环境。
# Docker Desktop: http://host.docker.internal:7890
# Colima: http://192.168.5.2:7890
# HTTP_PROXY=http://192.168.5.2:7890
# HTTPS_PROXY=http://192.168.5.2:7890
