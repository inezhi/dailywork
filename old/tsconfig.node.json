{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "apps/server/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "packages/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
